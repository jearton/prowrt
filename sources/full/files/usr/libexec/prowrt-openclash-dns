#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e
. /lib/functions.sh
. /lib/functions/network.sh

# OpenClash's UDP TProxy hook precedes fw4 dstnat. Return LAN DNS from both
# proxy chains so fw4 can redirect it locally, preserving the client address.
# Never create or enable a redirect on behalf of an administrator.
for chain in openclash openclash_mangle; do
	for handle in $(nft -a list chain inet fw4 "$chain" 2>/dev/null |
		awk '/comment "ProWrt local DNS before proxy"/ {print $NF}'); do
		nft delete rule inet fw4 "$chain" handle "$handle"
	done
done

config_load firewall
config_get kind technitium_dns_redirect TYPE
config_get_bool enabled technitium_dns_redirect enabled 1
config_get target technitium_dns_redirect target
config_get source_zone technitium_dns_redirect src
config_get dest_ip technitium_dns_redirect dest_ip
config_get dest_port technitium_dns_redirect dest_port
config_get source_port technitium_dns_redirect src_dport
[ "$kind" = redirect ] && [ "$enabled" = 1 ] && [ "$target" = DNAT ] &&
	[ -z "$dest_ip" ] && [ "$source_port" = 53 ] && [ "$dest_port" = 53 ] || exit 0

add_network() {
	local device chain
	network_get_device device "$1" || return 0
	case "$device" in ''|*[!a-zA-Z0-9_.:@-]*) return 1 ;; esac
	for chain in openclash openclash_mangle; do
		if nft list chain inet fw4 "$chain" >/dev/null 2>&1; then
			nft insert rule inet fw4 "$chain" iifname "\"$device\"" \
				meta nfproto ipv4 meta l4proto '{ tcp, udp }' th dport 53 \
				counter return comment '"ProWrt local DNS before proxy"'
		fi
	done
}

find_zone() {
	local name
	config_get name "$1" name
	[ "$name" = "$source_zone" ] || return 0
	config_list_foreach "$1" network add_network
}
config_foreach find_zone zone
