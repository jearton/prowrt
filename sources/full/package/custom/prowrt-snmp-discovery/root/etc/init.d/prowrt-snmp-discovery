#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
 config_load lingjing_snmp
 config_get_bool enabled main enabled 0
 [ "$enabled" = 1 ] || return 0
 # Preserve an existing site collector and its optional DHCP/PTR name collector.
 if [ -x /etc/init.d/lingjing-snmp ] && /etc/init.d/lingjing-snmp enabled; then
  logger -t prowrt-snmp 'Using existing lingjing-snmp collector; no duplicate polling'
  return 0
 fi
 procd_open_instance
 procd_set_param command /bin/sh -c 'while :; do /usr/libexec/prowrt-snmp-collect; sleep 60; done'
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
