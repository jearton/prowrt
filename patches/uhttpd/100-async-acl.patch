+/* ACL checks must never run ubus_complete_request() in the HTTP event loop.
+ * script_timeout is for long-running scripts, not authorization. */
+#define UH_UBUS_ACL_TIMEOUT_MS 5000
+
+struct uh_ubus_acl {
+	struct ubus_request req;
+	struct uloop_timeout timeout;
+	struct client *cl;
+	char *sid, *object, *function;
+	struct blob_attr *args;
+	bool allow;
+	bool subscribe;
+};
 
+static void uh_ubus_send_request(struct client *cl, const char *sid, struct blob_attr *args);
+static void uh_ubus_subscribe(struct client *cl, const char *path);
+
+static void uh_ubus_acl_destroy(struct uh_ubus_acl *acl)
+{
+	free(acl->sid);
+	free(acl->object);
+	free(acl->function);
+	free(acl->args);
+	free(acl);
+}
+
+static void uh_ubus_acl_free(struct client *cl)
+{
+	struct uh_ubus_acl *acl = cl->dispatch.req_data;
+	if (!acl)
+		return;
+	cl->dispatch.req_data = NULL;
+	uloop_timeout_cancel(&acl->timeout);
+	ubus_abort_request(ctx, &acl->req);
+	uh_ubus_acl_destroy(acl);
+}
+
+static void uh_ubus_acl_finish(struct uh_ubus_acl *acl, int status)
+{
+	struct client *cl = acl->cl;
+	bool allow = !status && acl->allow;
+
+	uloop_timeout_cancel(&acl->timeout);
+	cl->dispatch.req_data = NULL;
+	cl->dispatch.req_free = NULL;
+	/* Sending a response may finish the request and invoke its cleanup. */
+	uh_client_ref(cl);
+	if (cl->state < CLIENT_STATE_CLOSE) {
+		if (acl->subscribe) {
+			if (allow) {
+				uh_ubus_subscribe(cl, acl->object);
+			} else {
+				uh_ubus_send_header(cl, 200, "OK", "application/json");
+				uh_ubus_posix_error(cl, EACCES);
+			}
+		} else if (allow) {
+			cl->dispatch.ubus.func = acl->function;
+			uh_ubus_send_request(cl, acl->sid, acl->args);
+		} else {
+			uh_ubus_json_rpc_error(cl, status == UBUS_STATUS_TIMEOUT ? ERROR_TIMEOUT : ERROR_ACCESS);
+		}
+	}
+	uh_ubus_acl_destroy(acl);
+	uh_client_unref(cl);
+}
