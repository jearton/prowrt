--- /dev/null
+++ b/mac-miss-cache.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef NLBWMON_MAC_MISS_CACHE_H
+#define NLBWMON_MAC_MISS_CACHE_H
+
+#include <stdint.h>
+#include <string.h>
+
+/* Fixed memory; hash collisions evict an older failure rather than growing.
+ * A failed neighbor lookup must not permanently hide a newly reachable MAC.
+ * The upstream zero-initialized neigh_key is exactly 20 bytes. */
+#define MAC_MISS_SLOTS 4096
+#define MAC_MISS_KEY_SIZE 20
+#define MAC_MISS_TTL_MS 5000
+
+struct mac_miss_entry {
+	uint8_t key[MAC_MISS_KEY_SIZE];
+	uint64_t until;
+};
+
+struct mac_miss_cache {
+	struct mac_miss_entry entries[MAC_MISS_SLOTS];
+};
+
+static inline struct mac_miss_entry *
+mac_miss_slot(struct mac_miss_cache *cache, const void *key)
+{
+	const uint8_t *bytes = key;
+	uint32_t hash = 2166136261u;
+	unsigned int i;
+	for (i = 0; i < MAC_MISS_KEY_SIZE; i++)
+		hash = (hash ^ bytes[i]) * 16777619u;
+	return &cache->entries[hash & (MAC_MISS_SLOTS - 1)];
+}
+
+static inline int
+mac_miss_hit(struct mac_miss_cache *cache, const void *key, uint64_t now)
+{
+	struct mac_miss_entry *entry = mac_miss_slot(cache, key);
+	return now && entry->until > now && !memcmp(entry->key, key, MAC_MISS_KEY_SIZE);
+}
+
+static inline void
+mac_miss_mark(struct mac_miss_cache *cache, const void *key, uint64_t now)
+{
+	struct mac_miss_entry *entry = mac_miss_slot(cache, key);
+	if (!now)
+		return;
+	memcpy(entry->key, key, MAC_MISS_KEY_SIZE);
+	entry->until = now + MAC_MISS_TTL_MS;
+}
+
+static inline void
+mac_miss_forget(struct mac_miss_cache *cache, const void *key)
+{
+	struct mac_miss_entry *entry = mac_miss_slot(cache, key);
+	if (!memcmp(entry->key, key, MAC_MISS_KEY_SIZE))
+		entry->until = 0;
+}
+#endif
